# Copy the values into the deployment platform's encrypted environment settings.
# Never commit a populated production .env file.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=5
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pranaveda
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MAIL_ENABLED=false
MAIL_FROM=
MAIL_FROM_NAME=PranaVeda
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
