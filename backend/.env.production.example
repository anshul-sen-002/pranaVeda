# Copy the values into the deployment platform's encrypted environment settings.
# Never commit a populated production .env file.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=5
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=15d
# Optional: creates the first ADMIN user at startup if this email is absent.
# Store the password as a Vercel/host secret; use a unique strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pranaveda
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Enable after setting RESEND_API_KEY and verifying the MAIL_FROM domain.
MAIL_ENABLED=true
MAIL_FROM=
MAIL_FROM_NAME=PranaVeda
RESEND_API_KEY=
