# =====================================================================
# PranaVeda environment template - LOCAL defaults + EMPTY secrets.
# Copy to .env (git-ignored) and fill in your own values:
#     copy .env.example .env
#
# .env is gitignored; NEVER put real credentials in this template.
# Keep this list in sync with the environment contract table in
# docs/architecture.md ("Configuration and environment").
#
# CONVENTION: any line ending in `=` with nothing after it MUST be set
# in your own .env (local dev) or host secrets (prod). Anything with a
# value after `=` is a safe non-secret default you may override.
# =====================================================================

# --- Backend profile / port ---------------------------------------------
# Production deployments set SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database (LOCAL PostgreSQL 17 on Windows, later Supabase) ----------
# Dev:  your local instance - service postgresql-x64-17, port 5432.
#       Set DB_USERNAME / DB_PASSWORD to your local superuser (or a role you
#       created for PranaVeda) in .env.
# Prod: your managed PostgreSQL URL (Supabase pooler), set via the host's
#       secrets. NEVER commit it here.
DB_URL=jdbc:postgresql://localhost:5432/pranaveda
DB_USERNAME=
DB_PASSWORD=

# --- CORS ----------------------------------------------------------------
# Comma-separated EXACT origins. Production example:
#   CORS_ALLOWED_ORIGINS=https://pranaveda.app,https://www.pranaveda.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Authentication (JWT access + rotating refresh cookie) ---------------
# JWT_ACCESS_SECRET: REQUIRED, >= 32 bytes. Generate with:
#   openssl rand -base64 48
# TTLs accept Spring Duration syntax (15m, 1h, 14d).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
# Set REFRESH_COOKIE_SECURE=true in production (https only).
REFRESH_COOKIE_SECURE=false

# --- First ADMIN bootstrap -----------------------------------------------
# If BOTH are set and no account with this email exists, the backend creates
# the ADMIN account once on startup. No default admin is ever created.
# LOCAL DEV ONLY via .env - in production set real values via host secrets.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Media storage: Cloudinary or local disk --------------------------------
# Choose provider: "cloudinary" (production) or "local" (dev, no credentials).
# Local files are stored under app.storage.upload-dir and served via
# /api/v1/media/serve/. Cloudinary needs the three values below.
APP_STORAGE_PROVIDER=local
APP_STORAGE_UPLOAD_DIR=uploads

# Cloudinary (only needed when APP_STORAGE_PROVIDER=cloudinary).
# Find these on your Cloudinary Dashboard, or set CLOUDINARY_URL instead:
#   CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI wellness companion: OpenRouter -----------------------------------
# Optional locally. Without a key, /api/v1/ai/** returns 503 AI_UNAVAILABLE
# and the rest of the app is unaffected. Get a key at https://openrouter.ai
# NEVER put this key in the frontend - it stays server-side only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional override, e.g. a proxy: https://your-proxy.example/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Transactional email / SMTP (sign-in alerts) -------------------------
# Off by default (MAIL_ENABLED=false): no JavaMailSender bean is created and
# EmailService is a silent no-op - local dev needs no SMTP server.
# To enable: set MAIL_ENABLED=true plus MAIL_HOST and a real MAIL_PASSWORD
# below (e.g. a Gmail App Password), then restart the backend.
MAIL_ENABLED=false
MAIL_FROM=
MAIL_FROM_NAME=PranaVeda
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

