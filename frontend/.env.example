# =====================================================================
# PranaVeda frontend - LOCAL development environment
# Copy to .env.local (git-ignored) and adjust:  copy .env.example .env.local
#
# Only NON-SECRET values belong here. Next.js inlines anything prefixed
# NEXT_PUBLIC_ into the browser bundle, so never put API keys or secrets
# in a NEXT_PUBLIC_ variable (agents.md 3.2).
# =====================================================================

# Spring Boot API origin. Must match CORS_ALLOWED_ORIGINS in the backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Base URL of this app (used for canonical metadata / sitemap later).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
