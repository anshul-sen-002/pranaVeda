# =====================================================================
# PranaVeda environment template - copy to .env and adjust locally:
#     copy .env.example .env
#
# .env is gitignored; NEVER put real credentials in this template.
# Keep this list in sync with the environment contract table in
# docs/architecture.md ("Configuration and environment").
# =====================================================================

# --- Backend profile / port ---------------------------------------------
# Production deployments set SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database (LOCAL PostgreSQL 17 on Windows, no Docker) ---------------
# Dev:  your local instance - service postgresql-x64-17, port 5432.
#       Set DB_USERNAME / DB_PASSWORD to your local superuser (or a role you
#       created for PranaVeda) in .env.
# Prod: your managed PostgreSQL URL (set via the platform's secrets).
DB_USERNAME=postgres
DB_PASSWORD=change-me-locally
DB_URL=jdbc:postgresql://localhost:5432/pranaveda

# --- CORS ----------------------------------------------------------------
# Comma-separated EXACT origins. Production example:
#   CORS_ALLOWED_ORIGINS=https://pranaveda.example,https://www.pranaveda.example
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Phase 2+ (authentication; not read by the app yet) ------------------
# Required in production. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# --- Optional: first ADMIN bootstrap (Phase 2) ---------------------------
# If BOTH are set and no account with this email exists, the backend creates
# the ADMIN account on startup. No default admin is ever created.
ADMIN_EMAIL=
ADMIN_PASSWORD=
